#!/usr/bin/env node

const path = require("node:path");
const process = require("node:process");
const { getDirectories } = require("../shared/__filesystem");
const { isGitWorkingTree } = require("../shared/__git");
const { formatDate, runCommand, sortBy } = require("../shared/__shared");
const { yellow, brown, gray, red } = require("../shared/__colors");

// The root commit, without walking through the whole history and parsing
// the human-readable log output.
const GIT_ROOT_COMMIT = "git log --max-parents=0 --format=%aI%n%aN HEAD";

async function describeRepository(pathname) {
  const output = await runCommand(GIT_ROOT_COMMIT, { cwd: pathname });
  // A repository with several roots (e.g. merged subtrees) lists them all,
  // the oldest one is the last one.
  const lines = output.split("\n").filter(Boolean);
  const date = lines[lines.length - 2];
  const author = lines[lines.length - 1];
  return { startDate: new Date(date), author };
}

function toRecord(project) {
  const { projectName, startDate, author } = project;
  const date = formatDate(startDate);
  return `- [${brown(date)}] ${projectName} ${gray(author)}`;
}

function displayResults(projects) {
  const years = Object.keys(projects).sort();

  if (years.length === 0) {
    console.log(yellow("Not found any git repository in this directory"));
    return;
  }

  years.forEach((year) => {
    console.log(year);
    const projectRecords = projects[year]
      .sort(sortBy((v) => v.startDate.getTime()))
      .map(toRecord);
    console.log(projectRecords.join("\n"));
  });
}

async function collectProjects(files, workspacePath) {
  const projects = {};

  for (const file of files) {
    const pathname = path.resolve(workspacePath, file);

    if (!isGitWorkingTree(pathname)) {
      continue;
    }

    try {
      const { startDate, author } = await describeRepository(pathname);
      const year = startDate.getFullYear();
      projects[year] ??= [];
      projects[year].push({ startDate, pathname, projectName: file, author });
    } catch (error) {
      console.error(`${red("[error]")} ${file}: ${error.message}`);
    }
  }

  return projects;
}

async function main() {
  const workspacePath = process.argv[2] || process.cwd();
  const files = getDirectories(workspacePath).sort();
  const projects = await collectProjects(files, workspacePath);
  displayResults(projects);
}

main().catch((error) => {
  console.error(error.message);
  process.exitCode = 1;
});
