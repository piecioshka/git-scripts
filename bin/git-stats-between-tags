#!/usr/bin/env node

const process = require("node:process");
const { runCommand } = require("../shared/__shared");
const { green, red, gray, bold, yellow } = require("../shared/__colors");

const USAGE = `
    Usage: git stats-between-tags [PATTERN] [--level=minor|major]

    Displays commits, added and removed lines between consecutive tags.
    HEAD is treated as a special, final version of a tag.

    The --level option keeps only the tags of the given semver level, so
    the changes of the skipped tags are merged into the surrounding range.

    Examples:

        $ git stats-between-tags
        $ git stats-between-tags "v*"
        $ git stats-between-tags --level=minor
        $ git stats-between-tags "v*" --level=major
`;

// The SHA of an empty tree, the output of: git hash-object -t tree /dev/null
const EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904";
const ROOT_LABEL = "(root)";
const MILLISECONDS_IN_DAY = 24 * 60 * 60 * 1000;

// The output of `git diff --shortstat` skips parts that are zero, so
// `58 files changed, 5371 insertions(+)` and an empty string are both valid.
function parseShortstat(output) {
  const read = (pattern) => {
    const match = output.match(pattern);
    return match ? Number(match[1]) : 0;
  };
  return {
    files: read(/(\d+) files? changed/),
    added: read(/(\d+) insertions?\(\+\)/),
    removed: read(/(\d+) deletions?\(-\)/),
  };
}

// Without `from` the range starts at the beginning of the history, so the diff
// is counted from the empty tree. Otherwise `git diff <to>` would compare
// the tag with the working directory.
function createRange(from, to) {
  return {
    label: `${from ?? ROOT_LABEL}..${to}`,
    revRange: from ? `${from}..${to}` : to,
    diffRange: `${from ?? EMPTY_TREE}..${to}`,
    to,
  };
}

function buildRanges(tags, hasHeadCommits) {
  const ranges = tags.map((tag, index) => createRange(tags[index - 1], tag));

  if (!hasHeadCommits) {
    return ranges;
  }

  return ranges.concat(createRange(tags[tags.length - 1], "HEAD"));
}

// The `$` anchor drops the pre-releases (`v1.2.0-rc.1`), which otherwise
// would be counted as regular versions of the given level.
const LEVEL_PATTERNS = {
  minor: /^v?\d+\.\d+\.0$/,
  major: /^v?\d+\.0\.0$/,
};

function filterByLevel(tags, level) {
  if (!level) {
    return tags;
  }
  return tags.filter((tag) => LEVEL_PATTERNS[level].test(tag));
}

function parseArguments(argv) {
  const options = { pattern: undefined, level: undefined, help: false };

  argv.forEach((argument) => {
    if (argument === "--help" || argument === "-h") {
      options.help = true;
    } else if (argument.startsWith("--level=")) {
      options.level = argument.replace("--level=", "");
    } else if (!argument.startsWith("-")) {
      options.pattern = argument;
    }
  });

  return options;
}

async function getTags(pattern) {
  const list = pattern ? `--list "${pattern}"` : "";
  const output = await runCommand(`git tag ${list} --sort=creatordate`);
  return output.split("\n").filter(Boolean);
}

// Without tags the whole history is the only range, so there is always
// something to display. Otherwise an empty range would be a row full of zeros.
async function hasCommitsAfterTags(tags) {
  const lastTag = tags[tags.length - 1];

  if (!lastTag) {
    return true;
  }

  const output = await runCommand(`git rev-list --count ${lastTag}..HEAD`);
  return Number(output) > 0;
}

async function collectRangeStats(range) {
  const [commits, shortstat, authors, endDate] = await Promise.all([
    runCommand(`git rev-list --count ${range.revRange}`),
    runCommand(`git diff --shortstat ${range.diffRange}`),
    runCommand(`git log --format="%aN" ${range.revRange}`),
    runCommand(`git log -1 --format=%cs ${range.to}`),
  ]);

  const uniqueAuthors = new Set(
    authors.split("\n").filter((author) => author.trim().length > 0),
  );

  return {
    label: range.label,
    commits: Number(commits),
    authors: uniqueAuthors.size,
    endDate: endDate.trim(),
    ...parseShortstat(shortstat),
  };
}

function countDays(previousDate, currentDate) {
  const difference = new Date(currentDate) - new Date(previousDate);
  return Math.max(0, Math.round(difference / MILLISECONDS_IN_DAY));
}

function formatDelta(value) {
  const sign = value >= 0 ? "+" : "-";
  return `Δ${sign}${Math.abs(value)}`;
}

const pluralize = (count, noun) => `${count} ${noun}${count === 1 ? "" : "s"}`;

// Colors have to be applied after padding, because ANSI escape codes
// count towards the string length and would break the alignment.
const padColored = (value, width, color) =>
  color(String(value).padStart(width));

const paint = (value) => (value >= 0 ? green : red);

function displayResults(datalist, rootDate) {
  if (datalist.length === 0) {
    console.log(yellow("Not found any range to compare"));
    return;
  }

  const widthOf = (cb) => Math.max(...datalist.map((item) => cb(item).length));
  const widths = {
    label: widthOf((item) => item.label),
    commits: widthOf((item) => String(item.commits)),
    added: widthOf((item) => `+${item.added}`),
    removed: widthOf((item) => `-${item.removed}`),
    delta: widthOf((item) => formatDelta(item.added - item.removed)),
    files: widthOf((item) => String(item.files)),
  };

  const toRecord = (item, startDate) => {
    const delta = item.added - item.removed;
    const meta = [
      item.endDate,
      `${countDays(startDate, item.endDate)}d`,
      pluralize(item.authors, "author"),
    ].join(" · ");

    return [
      item.label.padEnd(widths.label),
      `${String(item.commits).padStart(widths.commits)} commits`,
      padColored(`+${item.added}`, widths.added, green),
      padColored(`-${item.removed}`, widths.removed, red),
      padColored(formatDelta(delta), widths.delta, paint(delta)),
      `${String(item.files).padStart(widths.files)} files`,
      gray(meta),
    ].join("  ");
  };

  const records = datalist.map((item, index) =>
    toRecord(item, datalist[index - 1]?.endDate ?? rootDate),
  );

  const sum = (cb) => datalist.reduce((result, item) => result + cb(item), 0);
  const total = {
    commits: sum((item) => item.commits),
    added: sum((item) => item.added),
    removed: sum((item) => item.removed),
  };
  const totalDelta = total.added - total.removed;

  const summary = [
    `${total.commits} commits`,
    green(`+${total.added}`),
    red(`-${total.removed}`),
    paint(totalDelta)(formatDelta(totalDelta)),
  ].join("  ");

  console.log(`\n${records.join("\n")}\n`);
  console.log(`${bold("Total:")} ${summary}\n`);
}

async function main() {
  const { pattern, level, help } = parseArguments(process.argv.slice(2));

  if (help) {
    console.log(USAGE);
    return;
  }

  if (level && !LEVEL_PATTERNS[level]) {
    console.error(yellow(`Unsupported level: ${level}`));
    console.log(USAGE);
    return void process.exit(1);
  }

  try {
    await runCommand("git rev-parse --git-dir");
  } catch (error) {
    console.error(yellow("Not a git repository"));
    return void process.exit(1);
  }

  const tags = filterByLevel(await getTags(pattern), level);

  if (tags.length === 0) {
    console.log(yellow("Not found any tag, comparing the whole history"));
  }

  const ranges = buildRanges(tags, await hasCommitsAfterTags(tags));
  const [datalist, rootDate] = await Promise.all([
    Promise.all(ranges.map(collectRangeStats)),
    runCommand("git log --reverse --format=%cs | head -n1"),
  ]);

  displayResults(datalist, rootDate.trim());
}

main().catch(console.error);
