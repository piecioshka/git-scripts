#!/usr/bin/env node

const process = require("node:process");
const { runCommand } = require("../shared/__shared");
const { isFile } = require("../shared/__filesystem");
const { listWorkspace, mapInOrder } = require("../shared/__workspace");
const {
  COMMON_OPTIONS,
  parseProjectsArgs,
  applyColorMode,
  gitColorMode,
  renderWorkingTreeLabels,
  renderUnpushedLabels,
  formatUnpushedBranches,
  formatHeader,
  formatError,
  formatSummary,
  quitOnClosedPipe,
} = require("../shared/__projects");
const {
  getGitBranchName,
  getGitUpstream,
  isGitBareRepository,
  isGitWorkingTree,
  isGitWorktree,
  isLocalOnlyGitRepository,
  countGitDirtyFiles,
  countGitUntrackedFiles,
  getGitUnpushedState,
} = require("../shared/__git");
const { brown, darkGreen } = require("../shared/__colors");

const USAGE = `
    Usage: [DEBUG=true] git projects-status [path=./] [--changed] [--color=WHEN] [--jobs=N]

    Shows the state of every project in the workspace: modified and untracked
    files, commits that are not pushed and branches that were never pushed.
    The changed files are listed below the repository.

    Options:

        --changed       hide the repositories that have nothing to report${COMMON_OPTIONS}
`;

async function getShortStatus(pathname) {
  const command = `git -c color.status=${gitColorMode()} status --short`;
  try {
    return await runCommand(command, { cwd: pathname });
  } catch (error) {
    return "";
  }
}

async function describePathname(pathname) {
  const start = Date.now();
  const result = {
    isFile: isFile(pathname),
    isBareRepository: isGitBareRepository(pathname),
    isWorkingTree: isGitWorkingTree(pathname),
    isWorktree: isGitWorktree(pathname),
  };
  if (result.isWorkingTree) {
    result.isLocalOnlyRepository = await isLocalOnlyGitRepository(pathname);
    result.dirtyFiles = await countGitDirtyFiles(pathname);
    result.untrackedFiles = await countGitUntrackedFiles(pathname);
    result.branchName = await getGitBranchName(pathname);
    result.isDetached = result.branchName === "";
    result.hasUpstream =
      !result.isDetached && (await getGitUpstream(pathname)) !== null;
    if (!result.isLocalOnlyRepository) {
      result.unpushed = await getGitUnpushedState(pathname);
    }
    if (result.dirtyFiles > 0 || result.untrackedFiles > 0) {
      result.shortStatus = await getShortStatus(pathname);
    }
  }
  result.elapsedTime = Date.now() - start;
  return result;
}

function hasNothingToReport(descriptor) {
  const { isWorkingTree, dirtyFiles, untrackedFiles, unpushed } = descriptor;
  if (!isWorkingTree) return true;
  const hasUnpushedWork =
    unpushed &&
    (unpushed.aheadCommits > 0 || unpushed.unpushedBranches.length > 0);
  return dirtyFiles === 0 && untrackedFiles === 0 && !hasUnpushedWork;
}

function renderLabels(descriptor) {
  const labels = renderWorkingTreeLabels(descriptor);
  if (!descriptor.isWorkingTree) return labels;
  if (descriptor.isLocalOnlyRepository) {
    labels.push("[local repo]");
  } else if (descriptor.isDetached) {
    labels.push(brown("[detached]"));
  } else if (!descriptor.hasUpstream) {
    labels.push(brown("[no upstream]"));
  }
  if (descriptor.unpushed) {
    labels.push(...renderUnpushedLabels(descriptor.unpushed));
  }
  if (hasNothingToReport(descriptor)) labels.push(darkGreen("[clean]"));
  return labels;
}

function printDescriptor(pathname, descriptor) {
  console.log(
    formatHeader({
      labels: renderLabels(descriptor),
      pathname,
      branchName: descriptor.isWorkingTree && descriptor.branchName,
      elapsedTime: descriptor.elapsedTime,
    }),
  );

  if (descriptor.unpushed) {
    const { unpushed, branchName } = descriptor;
    for (const line of formatUnpushedBranches(unpushed, branchName)) {
      console.log(line);
    }
  }
  if (descriptor.shortStatus) {
    for (const line of descriptor.shortStatus.split("\n")) {
      console.log(`    ${line}`);
    }
  }
}

function parseArgs(argv) {
  return parseProjectsArgs(argv, {
    usage: USAGE,
    defaults: { changed: false },
    parseOption(arg, options) {
      if (arg !== "--changed") return false;
      options.changed = true;
      return true;
    },
  });
}

async function main() {
  const options = parseArgs(process.argv.slice(2));
  if (options.help) return console.log(USAGE);
  applyColorMode(options.color);
  const pathnames = listWorkspace(options.workspacePath || process.cwd());
  const summary = { changed: 0, clean: 0, failures: 0 };
  await mapInOrder(
    pathnames,
    options.jobs,
    describePathname,
    (pathname, { value, error }) => {
      if (error) {
        summary.failures += 1;
        console.error(formatError(pathname, error));
        return;
      }
      const isClean = hasNothingToReport(value);
      if (value.isWorkingTree) summary[isClean ? "clean" : "changed"] += 1;
      if (options.changed && isClean) return;
      printDescriptor(pathname, value);
    },
  );
  console.log(
    formatSummary(
      [`${summary.changed} with changes`, `${summary.clean} clean`],
      summary.failures,
    ),
  );
  process.exitCode = summary.failures > 0 ? 1 : 0;
}

quitOnClosedPipe();

main().catch((err) => {
  console.error(err.message);
  process.exitCode = 1;
});
