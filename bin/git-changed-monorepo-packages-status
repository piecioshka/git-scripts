#!/usr/bin/env bash

set -e

folder="${1:-packages}"
base="${2:-main}"

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  echo "Usage: $(basename "$0") [folder=packages] [base=main]"
  exit 1
fi

git --no-pager diff "${base}.." --name-only |
  grep "^${folder}/" |
  cut -f2 -d/ |
  sort -u |
  xargs echo
