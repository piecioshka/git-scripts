#!/usr/bin/env node

const path = require("node:path");
const process = require("node:process");
const { isDirectory, getDirectories } = require("../shared/__filesystem");
const { isGitWorkingTree } = require("../shared/__git");
const { runCommand } = require("../shared/__shared");
const { underline, bold, blue, yellow, red } = require("../shared/__colors");

const USAGE = `
    Usage: git run-on-nested-repos COMMAND [--max-depth=N] [--color=WHEN]

    Runs the command in every Git repository found below the current directory.
    Nested repositories are not searched inside a repository.

    Options:

        --max-depth=N   how deep to look for repositories (default: 5)
        --color=WHEN    keep the colors of the command output: auto, always
                        or never (default: auto - only when printing to a
                        terminal, unless NO_COLOR is set)

    Examples:

        $ git run-on-nested-repos "git config --get remote.origin.url"
        $ git run-on-nested-repos "git status -sb" --max-depth=2
        $ git run-on-nested-repos "git branch --all" --color=always | less -R
`;

const DEFAULT_MAX_DEPTH = 5;
const COLOR_MODES = ["auto", "always", "never"];

function parseArguments(argv) {
  const options = {
    command: undefined,
    maxDepth: DEFAULT_MAX_DEPTH,
    color: "auto",
  };
  for (const argument of argv) {
    if (argument === "--help" || argument === "-h") {
      console.log(USAGE);
      process.exit(0);
    } else if (argument.startsWith("--max-depth=")) {
      const value = Number(argument.slice("--max-depth=".length));
      if (!Number.isInteger(value) || value < 1) {
        throw new Error(`Invalid value for --max-depth: ${argument}`);
      }
      options.maxDepth = value;
    } else if (argument.startsWith("--color=")) {
      const value = argument.slice("--color=".length);
      if (!COLOR_MODES.includes(value)) {
        throw new Error(`Invalid value for --color: ${argument}`);
      }
      options.color = value;
    } else if (argument.startsWith("-")) {
      throw new Error(`Unknown option: ${argument}\n${USAGE}`);
    } else if (options.command === undefined) {
      options.command = argument;
    } else {
      throw new Error(`Unexpected argument: ${argument}\n${USAGE}`);
    }
  }
  return options;
}

function shouldColorize(mode) {
  if (mode === "auto") {
    return Boolean(process.stdout.isTTY) && !process.env.NO_COLOR;
  }
  return mode === "always";
}

// The command runs with its stdout attached to a pipe, so Git (and most other
// tools) turn the colors off. These variables ask them to keep the colors.
function colorEnvironment() {
  const inherited = process.env.GIT_CONFIG_PARAMETERS;
  return {
    GIT_CONFIG_PARAMETERS: [inherited, "'color.ui=always'"]
      .filter(Boolean)
      .join(" "),
    FORCE_COLOR: "1",
    CLICOLOR_FORCE: "1",
  };
}

async function runInRepository(pathname, command, env) {
  console.log(`${underline(bold(yellow(pathname)))} ${blue(">")} ${command}`);
  try {
    const output = await runCommand(command, { cwd: pathname, env });
    if (output) {
      console.log(output);
    }
  } catch (error) {
    console.error(red(error.message));
    process.exitCode = 1;
  }
}

async function enter(currentPath, depth, { command, maxDepth, env }) {
  for (const name of getDirectories(currentPath).sort()) {
    const pathname = path.join(currentPath, name);

    if (!isDirectory(pathname)) {
      continue;
    }

    if (isGitWorkingTree(pathname)) {
      await runInRepository(pathname, command, env);
    } else if (depth < maxDepth) {
      await enter(pathname, depth + 1, { command, maxDepth, env });
    }
  }
}

async function main() {
  const options = parseArguments(process.argv.slice(2));

  if (!options.command) {
    console.log(USAGE);
    return void process.exit(1);
  }

  const env = shouldColorize(options.color) ? colorEnvironment() : undefined;
  await enter(process.cwd(), 1, { ...options, env });
}

main().catch((error) => {
  console.error(error.message);
  process.exitCode = 1;
});
