#!/usr/bin/env bash

set -e

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  __print_error "ERROR: is not a Git repository"
  exit 1
fi

repo=$(git config --get remote.origin.url || true)

if [ -n "$repo" ]; then
  __print_action "Copying origin URL: ${repo}"
fi

__print_warning "WARNING: the whole history, all branches, tags and stashes will be removed"

__print_command_and_eval rm -rf .git/
__print_command_and_eval git setup

if [ -n "$repo" ]; then
  __print_command_and_eval git remote add origin "$repo"
fi
