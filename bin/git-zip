#!/usr/bin/env bash

set -e

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=shared/__shared.sh
source "$script_dir/../shared/__shared.sh"

file_name="${1}"

if [ -z "$file_name" ]; then
  echo "Usage: $(basename "$0") <path/to/package.zip>"
  exit 1
fi

__print_action "Verify if repository has no changes"

if [ -z "$(git status --untracked-files=no --porcelain)" ]; then
  __print_title "No changes, building from clean repository"
  git archive --format zip --output "$file_name" HEAD
  __print_action "Package created: \"$file_name\""
else
  __print_title "Uncommitted changes, building from modified repository"
  git status --untracked-files=no -s
  echo ""

  stash=$(git stash create)
  if [ -z "$stash" ]; then
    __print_error "ERROR: cannot create a stash"
    exit 1
  fi
  git archive --format zip --output "$file_name" "$stash"
  __print_action "Package created: \"$file_name\""
fi

# `git archive` packs tracked content only, so untracked files would be missing
# from the package without a word. The package itself is not one of them, even
# though it usually lands inside the repository. `grep -c` exits with 1 when it
# counts zero, which `set -e` would otherwise treat as a failure.
untracked=$(git ls-files --others --exclude-standard | grep -cvxF -- "${file_name#./}" || true)

if [ "$untracked" -gt 0 ]; then
  __print_warning "WARNING: untracked files not included in the package: ${untracked}"
fi
