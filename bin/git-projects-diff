#!/usr/bin/env node

const process = require("node:process");
const { execFile } = require("node:child_process");
const { listWorkspace, mapInOrder } = require("../shared/__workspace");
const {
  COMMON_OPTIONS,
  parseProjectsArgs,
  applyColorMode,
  formatHeader,
  formatError,
  formatSummary,
  parseNumstatLine,
  sumLines,
  formatLineLabel,
  formatLineTotals,
  quitOnClosedPipe,
} = require("../shared/__projects");
const {
  getGitBranchName,
  isGitWorkingTree,
  countGitDirtyFiles,
  countGitUntrackedFiles,
} = require("../shared/__git");
const { red, cyan, green, gray } = require("../shared/__colors");

const USAGE = `
    Usage: [DEBUG=true] git projects-diff [path=./] [--stat] [--unified=N] [--color=WHEN] [--jobs=N]

    Shows the changes of tracked files, staged and unstaged (git diff HEAD), of
    every project in the workspace. Repositories without changes are skipped;
    untracked files are only counted, as Git has no diff for them.

    Options:

        --stat          lists only the changed files with the number of added
                        and removed lines instead of the diff, and adds the
                        totals to the summary
        --unified=N     lines of context around every change (default: 1)${COMMON_OPTIONS}
`;

const DEFAULT_UNIFIED = 1;

// Lockfiles and generated files make diffs far larger than the 1 MB that
// `exec` buffers by default.
const DIFF_MAX_BUFFER = 64 * 1024 * 1024;

function git(pathname, args) {
  return new Promise((resolve, reject) => {
    execFile(
      "git",
      args,
      { cwd: pathname, maxBuffer: DIFF_MAX_BUFFER },
      (error, stdout, stderr) => {
        if (error) {
          error.message = `${error.message}\n${stderr}`.trim();
          return reject(error);
        }
        resolve(stdout.trimEnd());
      },
    );
  });
}

async function hasCommits(pathname) {
  try {
    await git(pathname, ["rev-parse", "--verify", "--quiet", "HEAD"]);
    return true;
  } catch (error) {
    return false;
  }
}

// `git diff HEAD` needs a commit; a repository without one only has the index.
async function getDiffTarget(pathname) {
  return (await hasCommits(pathname)) ? "HEAD" : "--cached";
}

async function getDiff(pathname, { unified, color }) {
  return git(pathname, [
    "-c",
    `color.ui=${color ? "always" : "never"}`,
    "diff",
    `--unified=${unified}`,
    await getDiffTarget(pathname),
  ]);
}

async function getChangedFiles(pathname) {
  const output = await git(pathname, [
    "diff",
    "--numstat",
    await getDiffTarget(pathname),
  ]);
  return output ? output.split("\n").map(parseNumstatLine) : [];
}

async function describePathname(pathname, options) {
  const start = Date.now();
  if (!isGitWorkingTree(pathname)) return { isWorkingTree: false };
  const result = {
    isWorkingTree: true,
    dirtyFiles: await countGitDirtyFiles(pathname),
    untrackedFiles: await countGitUntrackedFiles(pathname),
    branchName: await getGitBranchName(pathname),
  };
  if (options.stat && result.dirtyFiles > 0) {
    result.files = await getChangedFiles(pathname);
  } else if (result.dirtyFiles > 0) {
    result.diff = await getDiff(pathname, options);
  }
  result.elapsedTime = Date.now() - start;
  return result;
}

function formatFile({ file, binary, added, removed }, width) {
  if (binary) return `    ${gray("binary".padEnd(width * 2 + 3))}  ${file}`;
  const plus = green(`+${added}`.padStart(width + 1));
  const minus = red(`-${removed}`.padStart(width + 1));
  return `    ${plus} ${minus}  ${file}`;
}

function printFiles(files) {
  const width = Math.max(
    ...files.map(({ added, removed }) =>
      Math.max(String(added).length, String(removed).length),
    ),
  );
  for (const file of files) console.log(formatFile(file, width));
  console.log("");
}

function renderLabels(descriptor) {
  const labels = [];
  if (descriptor.dirtyFiles > 0) {
    labels.push(red(`[dirty ${descriptor.dirtyFiles}]`));
  }
  if (descriptor.untrackedFiles > 0) {
    labels.push(cyan(`[untracked ${descriptor.untrackedFiles}]`));
  }
  if (descriptor.files) {
    labels.push(formatLineLabel(sumLines(descriptor.files)));
  }
  return labels;
}

function printDescriptor(pathname, descriptor) {
  console.log(
    formatHeader({
      labels: renderLabels(descriptor),
      pathname,
      branchName: descriptor.branchName,
      elapsedTime: descriptor.elapsedTime,
    }),
  );
  if (descriptor.diff) console.log(`${descriptor.diff}\n`);
  if (descriptor.files?.length > 0) printFiles(descriptor.files);
}

function parseUnified(arg) {
  const value = Number(arg.slice("--unified=".length));
  if (!Number.isInteger(value) || value < 0) {
    throw new Error(`Invalid value for --unified: ${arg}`);
  }
  return value;
}

function parseArgs(argv) {
  return parseProjectsArgs(argv, {
    usage: USAGE,
    defaults: { unified: DEFAULT_UNIFIED, stat: false },
    parseOption(arg, options) {
      if (arg === "--stat") {
        options.stat = true;
      } else if (arg.startsWith("--unified=")) {
        options.unified = parseUnified(arg);
      } else {
        return false;
      }
      return true;
    },
  });
}

function printSummary({ changed, clean, failures, lines }) {
  const parts = [`${changed} with changes`, `${clean} clean`];
  if (lines) parts.push(...formatLineTotals(lines));
  console.log(formatSummary(parts, failures));
}

async function main() {
  const options = parseArgs(process.argv.slice(2));
  if (options.help) return console.log(USAGE);
  const color = applyColorMode(options.color);
  const pathnames = listWorkspace(options.workspacePath || process.cwd());
  const summary = { changed: 0, clean: 0, failures: 0 };
  if (options.stat) summary.lines = { files: 0, added: 0, removed: 0 };
  await mapInOrder(
    pathnames,
    options.jobs,
    (pathname) => describePathname(pathname, { ...options, color }),
    (pathname, { value, error }) => {
      if (error) {
        summary.failures += 1;
        console.error(formatError(pathname, error));
        return;
      }
      if (!value.isWorkingTree) return;
      if (value.dirtyFiles === 0 && value.untrackedFiles === 0) {
        summary.clean += 1;
        return;
      }
      summary.changed += 1;
      if (value.files) {
        const { added, removed } = sumLines(value.files);
        summary.lines.files += value.files.length;
        summary.lines.added += added;
        summary.lines.removed += removed;
      }
      printDescriptor(pathname, value);
    },
  );
  printSummary(summary);
  process.exitCode = summary.failures > 0 ? 1 : 0;
}

quitOnClosedPipe();

main().catch((err) => {
  console.error(err.message);
  process.exitCode = 1;
});
