#!/usr/bin/env bash

set -e

# Shows `git diff --unified=1` of every Git repository found below the current
# directory. The options (--max-depth, --color) go to `git run-on-nested-repos`,
# which keeps the colors when printing to a terminal.
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<'EOF'

    Usage: git projects-diff [--max-depth=N] [--color=WHEN]

    Shows the unstaged changes (with one line of context) of every Git
    repository found below the current directory. The options are passed to
    `git run-on-nested-repos`.

EOF
    exit 0
fi

exec git run-on-nested-repos "git diff --unified=1" "$@"
