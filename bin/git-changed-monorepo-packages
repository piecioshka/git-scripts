#!/usr/bin/env node

const process = require("node:process");
const { runCommand } = require("../shared/__shared");
const { getProcessOptions } = require("../shared/__cli");

const USAGE = `
    Usage: git changed-monorepo-packages [--oneline] [--base=main] [--folder=packages]

    Options:

        --oneline           print the package names in one line
        --base=BRANCH       branch to compare with (default: main)
        --folder=FOLDER     folder with the packages (default: packages)

    Examples:

        $ git changed-monorepo-packages
        $ git changed-monorepo-packages --oneline
        $ git changed-monorepo-packages --base=develop
`;

const DEFAULT_BASE = "main";
const DEFAULT_FOLDER = "packages";

const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

async function collectChangedPackages({ base, folder }) {
  const command = `git diff "${base}.." --name-only`;
  const diff = await runCommand(command);
  const packagePattern = new RegExp(`^${escapeRegExp(folder)}/([^/]+)/`);
  return diff.split("\n").reduce((list, filename) => {
    const matched = filename.match(packagePattern);
    if (matched) {
      list.add(matched[1]);
    }
    return list;
  }, new Set());
}

function displayOnelineResults(packages) {
  console.log([...packages].join(" "));
}

function displayRegularList(packages) {
  console.log("List of packages with changed files:\n");
  packages.forEach((name) => {
    console.log(`- ${name}`);
  });
}

function displayResults(options, packages) {
  if (options.oneline) {
    displayOnelineResults(packages);
  } else {
    displayRegularList(packages);
  }
}

async function main() {
  const options = getProcessOptions(process.argv.slice(2));
  if (options.help) {
    console.log(USAGE);
    return void process.exit(1);
  }
  const packages = await collectChangedPackages({
    base: options.base ?? DEFAULT_BASE,
    folder: options.folder ?? DEFAULT_FOLDER,
  });

  displayResults(options, packages);
}

main().catch((error) => {
  console.error(error.message);
  process.exitCode = 1;
});
