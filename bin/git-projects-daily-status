#!/usr/bin/env node

const path = require("node:path");
const process = require("node:process");
const { formatDate, runCommand } = require("../shared/__shared");
const { getDirectories } = require("../shared/__filesystem");
const { isGitWorkingTree, getGitBranchName } = require("../shared/__git");
const {
  bold,
  underline,
  white,
  red,
  green,
  yellow,
  magenta,
  cyan,
} = require("../shared/__colors");

// `git log --shortstat` prints a line like `3 files changed, 10 insertions(+), 2 deletions(-)`
// per commit, and skips the parts that are zero.
const STATS = {
  changes: / (\d+) files? changed/g,
  insertions: / (\d+) insertions?\(\+\)/g,
  deletions: / (\d+) deletions?\(-\)/g,
};

function sumMatches(output, pattern) {
  return [...output.matchAll(pattern)].reduce(
    (sum, match) => sum + Number(match[1]),
    0,
  );
}

async function countLines(pathname) {
  const today = formatDate(new Date());
  const command = `git log --all --since="${today} 00:00:00" --before="${today} 23:59:59" --shortstat --oneline`;
  const output = await runCommand(command, { cwd: pathname });

  return {
    pathname,
    branchName: await getGitBranchName(pathname),
    changes: sumMatches(output, STATS.changes),
    insertions: sumMatches(output, STATS.insertions),
    deletions: sumMatches(output, STATS.deletions),
  };
}

function displayProjectStatus(project) {
  const { pathname, branchName, changes, insertions, deletions } = project;
  const status = [
    `${changes} changes`,
    `${insertions} insertions`,
    `${deletions} deletions`,
  ];
  const statusColors = [
    changes > 0 ? cyan : white,
    insertions > 0 ? green : white,
    deletions > 0 ? red : white,
  ];
  console.log(
    `${underline(bold(yellow(pathname)))} ${magenta(`[${branchName}]`)}`,
  );
  status.forEach((item, index) => {
    console.log(`- ${statusColors[index](item)}`);
  });
}

async function collectProjects(files, workspacePath) {
  const repositories = files
    .map((name) => path.resolve(workspacePath, name))
    .filter(isGitWorkingTree);

  const results = await Promise.allSettled(repositories.map(countLines));

  results
    .filter((result) => result.status === "rejected")
    .forEach((result) => {
      console.error(`${red("[error]")} ${result.reason.message}`);
    });

  return results
    .filter((result) => result.status === "fulfilled")
    .map((result) => result.value)
    .filter((project) => project.changes > 0);
}

async function main() {
  const workspacePath = process.argv[2] || process.cwd();
  const files = getDirectories(workspacePath).sort();
  const projects = await collectProjects(files, workspacePath);

  if (projects.length === 0) {
    console.log(yellow("Nothing happened today"));
    return;
  }

  projects.forEach(displayProjectStatus);
}

main().catch((error) => {
  console.error(error.message);
  process.exitCode = 1;
});
