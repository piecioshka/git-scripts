#!/usr/bin/env node

const process = require("node:process");
const { runCommand } = require("../shared/__shared");
const { isFile } = require("../shared/__filesystem");
const { listWorkspace, mapInOrder } = require("../shared/__workspace");
const {
  COMMON_OPTIONS,
  parseProjectsArgs,
  applyColorMode,
  formatHeader,
  formatError,
  formatSummary,
  quitOnClosedPipe,
} = require("../shared/__projects");
const {
  getGitBranchName,
  getGitUpstream,
  isGitBareRepository,
  isGitRepository,
  isLocalOnlyGitRepository,
  countGitDirtyFiles,
  countGitUntrackedFiles,
  getGitUnpushedState,
  getAheadBranchesToList,
  isGitWorktree,
} = require("../shared/__git");
const {
  dimGray,
  italic,
  red,
  green,
  blue,
  brown,
  cyan,
  gray,
  darkGreen,
  yellow,
  brightYellow,
} = require("../shared/__colors");

const USAGE = `
    Usage: [DEBUG=true] git projects-update [path=./] [--verbose] [--color=WHEN] [--jobs=N]

    Updates every project in the workspace with \`git pull --ff-only\`. Dirty,
    detached and local-only repositories and the ones without an upstream are
    skipped; the work that origin does not have yet is reported for all of them.

    Options:

        --verbose       print the output of every successful update${COMMON_OPTIONS}
`;

const UPDATE_STATUS = {
  UP_TO_DATE: "up-to-date",
  UPDATED: "updated",
  FAILED: "failed",
};

let verboseEnabled = false;
let colorEnabled = true;

async function updateGitRepository(pathname) {
  // LC_ALL=C: the "Already up to date." check below depends on English output.
  // --ff-only: never start a merge or a rebase, so the repository can never be
  // left in a conflicted state by a batch update.
  const mode = colorEnabled ? "always" : "never";
  const command = `LC_ALL=C git -c color.ui=${mode} pull --ff-only`;
  try {
    const output = await runCommand(command, { cwd: pathname });
    const status = output.includes("Already up to date.")
      ? UPDATE_STATUS.UP_TO_DATE
      : UPDATE_STATUS.UPDATED;
    return { status, output };
  } catch (error) {
    const output = String(error.message)
      .replace(/^Command failed: .*\n?/, "")
      .trim();
    return { status: UPDATE_STATUS.FAILED, output };
  }
}

async function describePathname(pathname) {
  const start = Date.now();
  const result = {};
  result.isFile = isFile(pathname);
  result.isBareRepository = isGitBareRepository(pathname);
  result.isRepository = isGitRepository(pathname);
  result.isWorktree = isGitWorktree(pathname);
  result.isWorkingTree = result.isRepository || result.isWorktree;
  result.isLocalOnlyRepository = await isLocalOnlyGitRepository(pathname);
  result.dirtyFiles = await countGitDirtyFiles(pathname);
  result.isDirtyRepository = result.dirtyFiles > 0;
  result.branchName = await getGitBranchName(pathname);
  result.isDetached = result.isWorkingTree && result.branchName === "";
  result.hasUpstream =
    result.isWorkingTree &&
    !result.isDetached &&
    (await getGitUpstream(pathname)) !== null;
  const shouldBeUpdated =
    result.isWorkingTree &&
    !result.isLocalOnlyRepository &&
    !result.isDirtyRepository &&
    !result.isDetached &&
    result.hasUpstream;
  if (shouldBeUpdated) {
    const { status, output } = await updateGitRepository(pathname);
    result.updateStatus = status;
    result.updateOutput = output;
  }
  // Read after the pull, as it can bring a .gitignore that changes the count.
  // Unlike the unpushed work below, this applies to local-only repositories too.
  result.untrackedFiles = await countGitUntrackedFiles(pathname);
  // Read after the pull, so that an updated repository is compared against the
  // refs it has just fetched. Repositories skipped above are still inspected --
  // those are exactly the ones where unpushed work is easiest to forget -- but
  // their numbers reflect the last fetch, not the current state of the remote.
  if (result.isWorkingTree && !result.isLocalOnlyRepository) {
    result.unpushed = await getGitUnpushedState(pathname);
  }
  const end = Date.now();
  result.elapsedTime = end - start;
  return result;
}

function renderLabels(descriptor) {
  const {
    isFile,
    isBareRepository,
    isWorkingTree,
    isWorktree,
    isDirtyRepository,
    dirtyFiles,
    untrackedFiles,
    isDetached,
    hasUpstream,
    updateStatus,
    isLocalOnlyRepository,
    unpushed,
  } = descriptor;
  const labels = [];

  if (isFile) {
    labels.push(blue("[file]"));
    return labels;
  }
  if (isBareRepository) {
    labels.push(dimGray("[bare repo]"));
    return labels;
  }
  if (!isWorkingTree) {
    labels.push(brown("[not repo]"));
    return labels;
  }

  if (isWorktree) {
    labels.push(dimGray(italic("[worktree]")));
  }
  if (isDirtyRepository) {
    labels.push(red(`[dirty ${dirtyFiles}]`));
  }
  if (untrackedFiles > 0) {
    labels.push(cyan(`[untracked ${untrackedFiles}]`));
  }
  if (isLocalOnlyRepository) {
    labels.push("[local repo]");
  } else if (isDetached) {
    labels.push(brown("[detached]"));
  } else if (!hasUpstream) {
    labels.push(brown("[no upstream]"));
  }

  switch (updateStatus) {
    case UPDATE_STATUS.UP_TO_DATE:
      labels.push(darkGreen(`[${UPDATE_STATUS.UP_TO_DATE}]`));
      break;
    case UPDATE_STATUS.UPDATED:
      labels.push(green(`[${UPDATE_STATUS.UPDATED}]`));
      break;
    case UPDATE_STATUS.FAILED:
      labels.push(red("[update failed]"));
      break;
    default:
      break;
  }

  if (unpushed) {
    const { aheadCommits, aheadBranches, unpushedBranches } = unpushed;
    if (aheadCommits > 0) {
      const branches =
        aheadBranches.length > 1 ? ` in ${aheadBranches.length} branches` : "";
      labels.push(brightYellow(`[ahead ${aheadCommits}${branches}]`));
    }
    if (unpushedBranches.length > 0) {
      labels.push(yellow(`[never pushed ${unpushedBranches.length}]`));
    }
  }

  return labels;
}

function printDescriptor(pathname, descriptor) {
  const {
    elapsedTime,
    isWorkingTree,
    branchName,
    updateStatus,
    updateOutput,
    unpushed,
  } = descriptor;
  console.log(
    formatHeader({
      labels: renderLabels(descriptor),
      pathname,
      branchName: isWorkingTree && branchName,
      elapsedTime,
    }),
  );

  if (unpushed) {
    const aheadBranches = getAheadBranchesToList(
      unpushed.aheadBranches,
      branchName,
    );
    for (const branch of aheadBranches) {
      console.log(gray(`    ahead: ${branch}`));
    }
    for (const branch of unpushed.unpushedBranches) {
      console.log(gray(`    never pushed: ${branch}`));
    }
  }

  const isFailed = updateStatus === UPDATE_STATUS.FAILED;
  const isUpdated = updateStatus === UPDATE_STATUS.UPDATED;
  if (updateOutput && (isFailed || (verboseEnabled && isUpdated))) {
    console.log(updateOutput);
  }
}

function countResult(summary, descriptor) {
  switch (descriptor.updateStatus) {
    case UPDATE_STATUS.UPDATED:
      summary.updated += 1;
      break;
    case UPDATE_STATUS.UP_TO_DATE:
      summary.upToDate += 1;
      break;
    case UPDATE_STATUS.FAILED:
      summary.failures += 1;
      break;
    default:
      if (descriptor.isWorkingTree) summary.skipped += 1;
  }
}

function parseArgs(argv) {
  return parseProjectsArgs(argv, {
    usage: USAGE,
    defaults: { verbose: false },
    parseOption(arg, options) {
      if (arg !== "--verbose") return false;
      options.verbose = true;
      return true;
    },
  });
}

async function main() {
  const options = parseArgs(process.argv.slice(2));
  if (options.help) return console.log(USAGE);
  verboseEnabled = options.verbose;
  colorEnabled = applyColorMode(options.color);
  const pathnames = listWorkspace(options.workspacePath || process.cwd());
  const summary = { updated: 0, upToDate: 0, skipped: 0, failures: 0 };
  await mapInOrder(
    pathnames,
    options.jobs,
    describePathname,
    (pathname, { value, error }) => {
      if (error) {
        summary.failures += 1;
        console.error(formatError(pathname, error));
        return;
      }
      printDescriptor(pathname, value);
      countResult(summary, value);
    },
  );
  console.log(
    formatSummary(
      [
        `${summary.updated} updated`,
        `${summary.upToDate} up-to-date`,
        summary.skipped > 0 && `${summary.skipped} skipped`,
      ],
      summary.failures,
    ),
  );
  process.exitCode = summary.failures > 0 ? 1 : 0;
}

quitOnClosedPipe();

main().catch((err) => {
  console.error(err.message);
  process.exitCode = 1;
});
