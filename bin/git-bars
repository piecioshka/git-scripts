#!/usr/bin/env node

const process = require("node:process");
const { runCommand, pad2Zeros, pad5 } = require("../shared/__shared");

const USAGE = `
    Usage: git bars COMMITTER_NAME PERIOD

    Examples:

        $ git bars "Piotr Kowalski" 2020
        $ git bars "Piotr Kowalski" 2021-04
`;

const isSingleYear = (period) => /^\d{4}$/.test(period);
const isMonth = (period) => /^\d{4}-\d{2}$/.test(period);
// https://graphemica.com/%E2%96%A0
const bars = (count) => "■".repeat(count);

// `new Date(year, month, 0)` is the last day of the previous month, so with
// the 1-based month it returns the length of the requested month, including
// February of a leap year.
const daysInMonth = (year, month) => new Date(year, month, 0).getDate();

const quote = (value) => `"${value.replace(/(["\\$`])/g, "\\$1")}"`;

// `git shortlog` matches the author with a regular expression, so the output
// may contain a line for every matching author. Sum them up.
function parseShortlog(output) {
  return output
    .split("\n")
    .map((line) => Number(line.trim().split(/\s+/)[0]))
    .filter(Number.isFinite)
    .reduce((sum, value) => sum + value, 0);
}

async function getShortlog({ author, label, periodStart, periodEnd }) {
  // HEAD is passed explicitly, otherwise `git shortlog` reads the log from stdin.
  const command = `git shortlog -sn --author=${quote(author)} --since=${quote(periodStart)} --before=${quote(periodEnd)} HEAD`;
  const output = await runCommand(command);
  return { period: label, value: parseShortlog(output) };
}

function displayBars(datalist) {
  let result = ``;
  let quantity = 0;
  datalist.forEach((item) => {
    quantity += item.value;
    result += `${item.period} ${pad5(item.value)} ${bars(item.value)}\n`;
  });
  console.log(`\n${quantity} commits\n${result}`);
}

function createCollection(length, cb) {
  return Array.from({ length }, (_, index) => cb(index));
}

// The ranges are half-open: `--since` is inclusive and `--before` points at
// the first second of the next period, so no commit is counted twice.
function buildPeriods(period) {
  if (isSingleYear(period)) {
    const year = Number(period);
    return createCollection(12, (index) => {
      const month = pad2Zeros(index + 1);
      const days = daysInMonth(year, index + 1);
      return {
        label: `${year}-${month}`,
        periodStart: `${year}-${month}-01 00:00:00`,
        periodEnd: `${year}-${month}-${days} 23:59:59`,
      };
    });
  }

  if (isMonth(period)) {
    const [year, month] = period.split("-").map(Number);
    return createCollection(daysInMonth(year, month), (index) => {
      const day = pad2Zeros(index + 1);
      const label = `${year}-${pad2Zeros(month)}-${day}`;
      return {
        label,
        periodStart: `${label} 00:00:00`,
        periodEnd: `${label} 23:59:59`,
      };
    });
  }

  throw new Error(`Unsupported period: ${period}`);
}

async function importData({ author, period }) {
  const results = [];
  // Sequentially: one git process at a time instead of 31 in parallel.
  for (const range of buildPeriods(period)) {
    results.push(await getShortlog({ author, ...range }));
  }
  return results;
}

async function main() {
  const author = process.argv[2];
  const period = process.argv[3];

  if (!author || !(isSingleYear(period) || isMonth(period))) {
    console.log(USAGE);
    return void process.exit(1);
  }

  displayBars(await importData({ author, period }));
}

main().catch((error) => {
  console.error(error.message);
  process.exitCode = 1;
});
