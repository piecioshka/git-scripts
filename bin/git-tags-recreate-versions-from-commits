#!/usr/bin/env bash

set -e

# Finds all commits with a semantic version as the whole subject (e.g. "1.2.3")
# and creates the annotated tags "v1.2.3" for them, unless they already exist.

git log --format='%H %s' |
  grep -E '^[0-9a-f]{40} [0-9]+\.[0-9]+\.[0-9]+$' |
  while read -r sha version; do
    tag="v${version}"

    if git rev-parse --quiet --verify "refs/tags/${tag}" > /dev/null; then
      continue
    fi

    if git tag -a "$tag" -m "$tag" "$sha" 2> /dev/null; then
      echo "Created tag $tag for commit $sha"
    else
      echo "Failed to create tag $tag for commit $sha" >&2
    fi
  done
